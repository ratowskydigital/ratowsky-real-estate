# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://ratowskyrealestate.com

# ---------------------------------------------------------------------------
# Contact form — Gmail (primary notification path)
# From Google Cloud Console → OAuth2 credentials for justin.ratowsky@compass.com
# ---------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
NOTIFY_EMAIL=justin.ratowsky@compass.com

# ---------------------------------------------------------------------------
# Contact form — Resend (fallback if Gmail fails)
# https://resend.com — free tier is fine to start
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@ratowskyrealestate.com

# ---------------------------------------------------------------------------
# Lead capture — Google Sheets
# Service account JSON (paste entire JSON as one line, or use a secret)
# The sheet must have a tab named "Leads" with headers in row 1:
#   Timestamp | Name | Email | Phone | Intent | Source | Message
# Share the sheet with the service account email (Editor role)
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_SHEETS_ID=1_your_spreadsheet_id_here

# ---------------------------------------------------------------------------
# CoreLogic Trestle MLS (scaffold — activate when you receive credentials)
# https://trestle.corelogic.com
# ---------------------------------------------------------------------------
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Supabase (optional — scaffold present but not required to launch)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Anthropic Claude API (server-side only — never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
