{
  "name": "ratowskyrealestate-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "geo:check": "tsx --tsconfig tsconfig.scripts.json scripts/geo-check.ts",
    "geo:export": "tsx --tsconfig tsconfig.scripts.json scripts/geo-export.ts",
    "prebuild": "npm run geo:check && npm run geo:smoke && npm run geo:export",
    "geo:smoke": "tsx --tsconfig tsconfig.scripts.json scripts/geo-smoke.ts"
  },
  "dependencies": {
    "next": "15.5.15",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.15",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.13",
    "typescript": "5.7.3"
  }
}
